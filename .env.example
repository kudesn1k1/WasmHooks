# Copy to .env to override. Every value below is the default compose.yaml already uses.

# PostgreSQL
PG_USER=wasmhooks
PG_PASSWORD=wasmhooks
PG_DB=controlplane

# MinIO / S3 credentials (shared by MinIO, the bucket init job and the control plane)
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Token the data plane presents on /internal/v1/* (control plane CP_INTERNAL_TOKEN)
INTERNAL_TOKEN=dev-internal-token-change-me

# HMAC secret for tenant JWTs; must be at least 32 characters
TENANT_JWT_SECRET=dev-tenant-jwt-secret-change-me-0123456789
